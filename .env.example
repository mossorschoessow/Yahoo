################################################################
# 1. AI 模型（必填才能用 AI 判斷；沒填會改用「只比價格」的規則模式）
################################################################
# 任何 OpenAI 相容的 API 都可以，模型必須支援圖片輸入（Vision）
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1/
OPENAI_MODEL_NAME=gpt-4o-mini

# 圖片傳給 AI 的方式：base64（最相容）| url（省流量，但部分服務抓不到）| none（不傳圖）
AI_IMAGE_MODE=base64
# 每件商品最多傳幾張圖
AI_MAX_IMAGES=4
# 模型不支援 response_format=json_object 時設 false（程式也會自動退回）
AI_RESPONSE_FORMAT_JSON=true
AI_DEBUG=false
# AI 請求代理（可選），例如 http://127.0.0.1:7890
AI_PROXY_URL=

################################################################
# 2. 爬取設定
################################################################
# 每次請求日拍之間的間隔秒數（請不要調太小，對伺服器友善一點，也比較不會被擋）
REQUEST_DELAY_SECONDS=3
# 任務最短執行間隔（分鐘）
MIN_INTERVAL_MINUTES=5
# 每次執行最多分析幾件新商品（控制 AI 花費），其餘留到下次
MAX_AI_PER_RUN=20
# 勾選的任務最多幾個同時執行，其餘排隊
MAX_CONCURRENT_TASKS=3
# 成交行情快取幾小時
MARKET_CACHE_HOURS=6
# 日拍請求代理（可選）
SCRAPE_PROXY_URL=

################################################################
# 3. 匯率顯示（可選）：通知裡會多顯示換算金額，0 = 不顯示
################################################################
LOCAL_CURRENCY=TWD
JPY_TO_LOCAL_RATE=0

################################################################
# 4. Web 介面
################################################################
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# 設定密碼就會啟用登入；若把 SERVER_HOST 改成 0.0.0.0 讓別台電腦連，一定要設密碼
WEB_USERNAME=admin
WEB_PASSWORD=

################################################################
# 5. 通知（設定任一個即可）
################################################################
# Telegram：找 @BotFather 建 bot 拿 token，找 @userinfobot 拿 chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Discord 頻道 Webhook（頻道設定 → 整合 → Webhook）
DISCORD_WEBHOOK_URL=

# ntfy（手機裝 ntfy App 訂閱同一個 topic），例如 https://ntfy.sh/my-yahoo-xxxx
NTFY_TOPIC_URL=

# Bark（iOS），例如 https://api.day.app/你的key
BARK_URL=

# 通用 Webhook：POST JSON {title, content, item, analysis}
WEBHOOK_URL=
